# Copy to .env or projects/chatApp/.env / projects/solarium/.env for local development.
# On Render, set these in the service Environment dashboard (do not commit real values).

# ChatApp MongoDB (required) — use either name; MONGO_URL is preferred
MONGO_URL=
# MONGO_URI=

# Solarium MongoDB (required for Solarium features)
SOLARIUM_MONGO=

# Auth (required for login/JWT)
JWT_SECRET=

# Render sets PORT automatically; locally defaults to 3000
# PORT=3000

# Optional ChatApp features
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# FRONTEND_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
